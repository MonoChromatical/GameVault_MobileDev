<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GameVault.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Home">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="GameVault" FontSize="30" FontAttributes="Bold" />
            <Label Text="Popular Games" FontSize="24" FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding PopularGames}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10" Margin="0,0,0,10">
                            <VerticalStackLayout>
                                <Label Text="{Binding Title}" FontAttributes="Bold" />
                                <Label Text="{Binding Genre}" />
                                <Label Text="{Binding Platform}" />
                                <Label Text="{Binding Rating, StringFormat='Rating: {0}/5'}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>